<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@drawable/widget_background_glass">

    <ProgressBar
        android:id="@+id/pb_battery_circle"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="75"
        android:progressDrawable="@drawable/circular_progress_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tv_battery_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="75%"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/pb_battery_circle"
        app:layout_constraintEnd_toEndOf="@+id/pb_battery_circle"
        app:layout_constraintStart_toStartOf="@+id/pb_battery_circle"
        app:layout_constraintTop_toTopOf="@+id/pb_battery_circle" />

    <TextView
        android:id="@+id/tv_label_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Battery"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/pb_battery_circle"
        app:layout_constraintBottom_toTopOf="@+id/tv_battery_status"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_battery_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Charging"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/tv_label_battery"
        app:layout_constraintTop_toBottomOf="@+id/tv_label_battery"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Resize Handles -->
    <ImageView
        android:id="@+id/btn_resize_left"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_media_previous"
        android:background="@drawable/badge_background"
        android:backgroundTint="#80000000"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/btn_resize_right"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_media_next"
        android:background="@drawable/badge_background"
        android:backgroundTint="#80000000"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
