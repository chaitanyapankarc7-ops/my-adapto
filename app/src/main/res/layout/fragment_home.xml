<?xml version="1.0" encoding="utf-8"?>

<com.tejyash.myadapto.launcher.SwipeUpFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_swipe_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Floating Adaptive Features Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_adaptive_features"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            app:srcCompat="@drawable/ic_launcher_foreground"
            app:tint="#FFFFFF"
            app:backgroundTint="#5B8CFF"
            app:fabSize="normal"
            app:elevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/dock_container" />

        <!-- Greeting stays fixed -->
        <TextView
            android:id="@+id/home_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="Good morning"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!--
            EVERYTHING below the greeting is now inside ViewPager2.

            Each ViewPager page contains:
            CLOCK
            BATTERY
            WEATHER
            APPS
            EMPTY CELLS
        -->

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_home_pages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/home_greeting"
            app:layout_constraintBottom_toTopOf="@id/dock_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Bottom dock remains fixed -->
        <LinearLayout
            android:id="@+id/dock_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:background="#CC1A1A2E"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Gallery -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/dock_gallery"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Gallery"
                    app:srcCompat="@drawable/images_removebg_preview__4_" />

                <TextView
                    android:id="@+id/dock_gallery_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gallery"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- Phone -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/dock_phone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Phone"
                    app:srcCompat="@drawable/images_removebg_preview__3_" />

                <TextView
                    android:id="@+id/dock_phone_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- Camera -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/dock_camera"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Camera"
                    app:srcCompat="@drawable/download__5__removebg_preview" />

                <TextView
                    android:id="@+id/dock_camera_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Camera"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- Contacts -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/dock_contacts"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Contacts"
                    app:srcCompat="@drawable/images__1__removebg_preview__1_" />

                <TextView
                    android:id="@+id/dock_contacts_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contacts"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Remove from Home drop target -->

        <TextView
            android:id="@+id/remove_from_home_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="&#8722;  Delete from Home"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/pill_background"
            android:backgroundTint="#CCE53935"
            android:elevation="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.tejyash.myadapto.launcher.SwipeUpFrameLayout>