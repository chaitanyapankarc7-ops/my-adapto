<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#205B8CFF" />
        </shape>
    </item>

    <!-- Main Gradient Circle -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#2563EB"
                android:endColor="#4F46E5"
                android:angle="135" />
            <stroke
                android:width="2dp"
                android:color="#B0FFFFFF" />
        </shape>
    </item>

    <!-- Glassy Overlay -->
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#60FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"
                android:centerY="0.3"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
