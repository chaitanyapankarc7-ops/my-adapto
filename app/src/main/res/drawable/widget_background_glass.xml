<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Shadow / Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#1A000000" />
        </shape>
    </item>

    <!-- Premium Frosted Glass Effect -->
    <item android:bottom="2dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4DFFFFFF"
                android:centerColor="#26FFFFFF"
                android:endColor="#1AFFFFFF"
                android:angle="135" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>

    <!-- Top Gloss Highlight -->
    <item android:top="2dp" android:left="8dp" android:right="8dp" android:bottom="60dp">
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
