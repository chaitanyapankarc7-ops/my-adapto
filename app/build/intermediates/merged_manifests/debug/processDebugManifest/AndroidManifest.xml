<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tejyash.myadapto"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <!-- Required for dialler intent and contacts -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
        Android 11+ requires declaring which apps you want to query.
        This tells the OS we need to see all launchable apps (for the grid).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        Belt-and-suspenders for real devices (some OEM skins are stricter
        than stock AOSP about package visibility even with <queries>
        declared correctly above). This permission is auto-granted at
        install time for apps not distributed via Play Store, so it's
        safe here — see AppManager.loadInstalledApps() for the fallback
        loading path that benefits from it.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <permission
        android:name="com.tejyash.myadapto.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.tejyash.myadapto.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.MyAdapto" >

        <!-- Entry point (splash/welcome) — app icon in launcher -->
        <activity
            android:name="com.tejyash.myadapto.activity.GetStartedPage"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Profile selection -->
        <activity
            android:name="com.tejyash.myadapto.activity.InfoPage"
            android:exported="false" />

        <!-- Accessibility settings (font/icon/contrast) -->
        <activity
            android:name="com.tejyash.myadapto.activity.SizeEditingPage"
            android:exported="false" />

        <!-- Voice assistant screen -->
        <activity
            android:name="com.tejyash.myadapto.activity.VoiceAssitentPage"
            android:exported="false" />

        <!-- Motor accessibility info -->
        <activity
            android:name="com.tejyash.myadapto.activity.AssitentInfoage"
            android:exported="false" />

        <!--
            HOME LAUNCHER — the actual adaptive home screen.
            launchMode="singleTask": Android never makes a second instance.
            stateNotNeeded="true": can be killed/restarted cleanly with no crash.
            The HOME + DEFAULT intent categories are what makes Android recognise
            this as a launcher option in the "Select home app" dialog.
        -->
        <activity
            android:name="com.tejyash.myadapto.launcher.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.MyAdapto.Launcher" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
             Notification badges: user must manually enable this in
             Settings > Notification access. See NotificationAccessHelper.
        -->
        <service
            android:name="com.tejyash.myadapto.notifications.AdaptoNotificationListenerService"
            android:exported="false"
            android:label="MyAdapto Notification Badges"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" >
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.tejyash.myadapto.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>