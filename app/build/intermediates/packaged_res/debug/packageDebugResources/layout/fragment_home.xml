<?xml version="1.0" encoding="utf-8"?>
<!--
    HomeFragment layout — "Home" page of the pager.

    Root is now SwipeUpFrameLayout itself, wrapping EVERYTHING (not just
    the dock) — swipe up to open the drawer works from anywhere on this
    screen, not a dedicated strip. It still lets normal taps/clicks reach
    icons/dock/cards underneath (see SwipeUpFrameLayout), only stealing
    the gesture once a touch proves itself as a real vertical drag.

    Top to bottom inside: Adapto logo, greeting, clock, weather, battery
    card, then the multi-page app grid, then the bottom dock. The
    "Remove from Home" pill sits near the top, hidden until a Home icon
    reposition-drag is in progress (see HomeFragment.handleDrop).
-->
<com.tejyash.myadapto.launcher.SwipeUpFrameLayout
    android:id="@+id/home_swipe_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/home_logo"
            android:layout_width="120dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            app:srcCompat="@drawable/img_11"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/home_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Good morning"
            android:textColor="#F7960DC7"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/home_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/home_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="--:--"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            app:layout_constraintTop_toBottomOf="@id/home_greeting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/weather_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/home_clock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_weather"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_weather_sunny"
            android:contentDescription="Weather" />

        <TextView
            android:id="@+id/txt_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="28°C • Sunny"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#AA1B1B2F"
            app:layout_constraintTop_toBottomOf="@id/weather_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Battery Icon -->
                <ImageView
                    android:id="@+id/img_battery"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_lock_idle_charging"
                    android:tint="#FFFFFF"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <!-- Title -->
                <TextView
                    android:id="@+id/txtBatteryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    app:layout_constraintTop_toTopOf="@id/img_battery"
                    app:layout_constraintStart_toEndOf="@id/img_battery"
                    android:layout_marginStart="12dp"/>

                <!-- Percentage -->
                <TextView
                    android:id="@+id/txtBatteryPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="82%"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/txtBatteryTitle"
                    app:layout_constraintStart_toStartOf="@id/txtBatteryTitle"/>

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressBattery"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="82"
                    app:layout_constraintTop_toBottomOf="@id/txtBatteryPercent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="16dp"/>

                <!-- Status -->
                <TextView
                    android:id="@+id/txtBatteryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Charging"
                    android:textColor="#7CFC00"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/progressBattery"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="12dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Multi-page Home grid — swipe left/right between pages. Each page
             is its own HomeGridAdapter-backed RecyclerView (see
             HomePagesAdapter), holding only apps placed there. A new blank
             page appears automatically once the current ones fill up, and
             dragging an app to the right edge while dragging also reveals
             the next page — see HomeFragment.handleDrop(). -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_home_pages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/card_battery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/dock_container" />

        <!-- Bottom dock — same 4 quick-access slots as before. -->
        <LinearLayout
            android:id="@+id/dock_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="#CC1A1A2E"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Gallery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/dock_gallery"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Gallery"
                    app:srcCompat="@drawable/images_removebg_preview__4_" />
                <TextView android:id="@+id/dock_gallery_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Gallery" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/dock_phone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Phone"
                    app:srcCompat="@drawable/images_removebg_preview__3_" />
                <TextView android:id="@+id/dock_phone_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Phone" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <!-- Camera -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/dock_camera"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Camera"
                    app:srcCompat="@drawable/download__5__removebg_preview" />
                <TextView android:id="@+id/dock_camera_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Camera" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <!-- Contacts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/dock_contacts"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Contacts"
                    app:srcCompat="@drawable/images__1__removebg_preview__1_" />
                <TextView android:id="@+id/dock_contacts_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Contacts" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <!-- SOS and Voice removed for now — will be added back later
                 (likely as part of the AI/adaptive layer, not fixed dock slots). -->

        </LinearLayout>

        <!-- "Remove from Home" drop target — hidden by default, shown only
             while repositioning an already-placed Home icon (see
             HomeGridAdapter's long-press drag and HomeFragment.handleDrop).
             Drag an icon up here and release to take it off Home. -->
        <TextView
            android:id="@+id/remove_from_home_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="&#8722;  Remove from Home"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/pill_background"
            android:backgroundTint="#CCE53935"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.tejyash.myadapto.launcher.SwipeUpFrameLayout>
